# Local development. Copy to .env and fill in. Production uses
# /etc/wcc/app.env on the VPS (template: infra/server/app.env.example).

# ── General ──
NODE_ENV=development
APP_NAME="WCC Media — The Life Cathedral"
# The browser only ever talks to WEB_ORIGIN; the web app's middleware proxies /api to API_INTERNAL_URL.
# On Vercel set: API_INTERNAL_URL=https://<server>.sslip.io, API_PROXY_SECRET=<from setup.sh>, MEDIA_ORIGINS.
WEB_ORIGIN=http://localhost:3000
API_PREFIX=api/v1
API_INTERNAL_URL=http://localhost:4000
API_PROXY_SECRET=
PORT=4000
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=0
TZ=Africa/Accra

# ── Database: Neon (or a local Postgres). Quote the URLs: they contain `&`.
# Pooled endpoint (-pooler) for the app, direct endpoint for migrations.
DATABASE_URL=postgresql://wcc_dev:CHANGE_ME@localhost:5432/wcc_media_dev
DATABASE_MIGRATION_URL=postgresql://wcc_dev:CHANGE_ME@localhost:5432/wcc_media_dev

# ── Redis (pnpm dev:services starts one on 6379) ──
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=wcc

# ── Auth: generate with `openssl rand -base64 64` and `openssl rand -base64 32` ──
JWT_ACCESS_SECRET=
APP_ENCRYPTION_KEY=
REQUIRE_2FA_FOR_ADMINS=true
PWNED_PASSWORD_CHECK=false

# ── AWS (a dev bucket + dev IAM user) ──
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=wcc-media-dev

# ── Delivery: s3-presign needs no custom domain. Switch to cloudfront once the domain exists. ──
MEDIA_DELIVERY_MODE=s3-presign
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
# Hosts the browser loads media from / uploads to (CSP). The exact bucket host:
MEDIA_ORIGINS=https://wcc-media-dev.s3.eu-west-1.amazonaws.com

# ── Limits & processing ──
MAX_IMAGE_MB=60
MAX_VIDEO_GB=20
WORKER_TMP_DIR=./.tmp/worker
WORKER_TMP_RESERVE_GB=2
IMAGE_CONCURRENCY=2
VIDEO_CONCURRENCY=1
FFMPEG_THREADS=2
TRASH_RETENTION_DAYS=30

# ── Features ──
SHARE_LINKS_ENABLED=true
PUBLIC_HIGHLIGHTS_ENABLED=false
SWAGGER_ENABLED=true

# ── Mail (Plunk — https://useplunk.com; the From domain must be verified there) ──
PLUNK_SECRET=
MAIL_FROM="WCC Media <no-reply@westendcity.church>"
MAIL_REPLY_TO=
# Optional public https URL of the logo shown in emails (default: WEB_ORIGIN/logo.png when https)
MAIL_LOGO_URL=

# ── Seed (dev only) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Str0ng-Pass!

# Push notifications (Web Push / VAPID). Generate a pair once:  npx web-push generate-vapid-keys
# Both the API (public key) and the worker (both keys) read these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:customersupport@zuristudios.com
NOTIFICATIONS_ENABLED=true
# Weekly schedule (cron) in NOTIFY_TZ: reminders first, then the day's numbers.
NOTIFY_TZ=Africa/Accra
REMINDER_CRON_SATURDAY="0 20 * * 6"
REMINDER_CRON_SUNDAY="0 13 * * 0"
STATS_CRON_SATURDAY="0 22 * * 6"
STATS_CRON_SUNDAY="0 18 * * 0"
