{
  "name": "@wcc/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --tsconfig tsconfig.json --env-file=../../.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@wcc/db": "workspace:*",
    "@wcc/shared": "workspace:*",
    "archiver": "^7.0.1",
    "bullmq": "^5.81.5",
    "exiftool-vendored": "^39.2.0",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.20.5",
    "@wcc/tsconfig": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
