generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_MIGRATION_URL")
  extensions = [citext, pg_trgm]
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN
  PASTOR
  SHEPHERD
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum VariantKind {
  THUMB
  PREVIEW
  POSTER
  VIDEO_PREVIEW
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum ExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.Citext
  fullName          String     @db.VarChar(120)
  title             String?    @db.VarChar(40)
  phone             String?    @db.VarChar(30)
  role              Role       @default(VIEWER)
  status            UserStatus @default(INVITED)
  passwordHash      String?
  passwordChangedAt DateTime?
  totpSecretEnc     String?
  totpEnabled       Boolean    @default(false)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  avatarKey         String?
  /// Push notification preferences.
  notifyReminders   Boolean    @default(true)
  notifyStats       Boolean    @default(true)
  notifyBirthdays   Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions          Session[]
  categoryAccess    UserCategoryAccess[]
  eventsCreated     Event[]              @relation("EventCreatedBy")
  mediaUploaded     MediaAsset[]         @relation("MediaUploadedBy")
  invitationsSent   Invitation[]         @relation("InvitedBy")
  joinLinks         JoinLink[]
  auditLogs         AuditLog[]
  passwordResets    PasswordResetToken[]
  emailChanges      EmailChangeToken[]
  pastoredGroups    ChurchGroup[]        @relation("GroupPastor")
  groupsCreated     ChurchGroup[]        @relation("GroupCreatedBy")
  membersCreated    Member[]             @relation("MemberCreatedBy")
  attendanceTaken   AttendanceSession[]  @relation("AttendanceRecordedBy")
  shepherding       GroupShepherd[]
  pushSubscriptions PushSubscription[]
  /// Member accounts: the church member this login belongs to.
  memberId          String?              @unique @db.Uuid
  member            Member?              @relation("MemberAccount", fields: [memberId], references: [id], onDelete: SetNull)
  followUpsAssigned FollowUp[]           @relation("FollowUpAssignee")
  followUpsCreated  FollowUp[]           @relation("FollowUpCreator")
  followUpNotes     FollowUpNote[]
  rosterCreated     RosterSlot[]
  eventsCreated2    ChurchEvent[]
  rsvps             EventRsvp[]
  milestonesAdded   Milestone[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  recoveryCodes     RecoveryCode[]
  shareLinks        ShareLink[]
  exports           ExportJob[]

  @@index([role])
  @@index([status])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String    @db.Uuid
  refreshHash       String    @unique
  userAgent         String?   @db.VarChar(400)
  ipAddress         String?   @db.Inet
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(60)
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Invitation {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @db.Citext
  role          Role
  categoryIds   String[]  @db.Uuid
  /// Member accounts: the member record this invitation is for.
  memberId      String?   @db.Uuid
  member        Member?   @relation("MemberInvite", fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  invitedById   String    @db.Uuid
  invitedBy     User      @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Asked for through a QR join link.
  joinLinkId    String?   @db.Uuid
  joinLink      JoinLink? @relation(fields: [joinLinkId], references: [id], onDelete: SetNull)
  /// Pastor/shepherd requests from a join link wait for a Super Admin before the email goes out.
  needsApproval Boolean   @default(false)
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Pending email change: confirmed by a link sent to the new address.
model EmailChangeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String    @db.Citext
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

// ───────────────────────── Taxonomy ─────────────────────────

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique @db.VarChar(60)
  name           String   @db.VarChar(80)
  description    String?  @db.VarChar(500)
  sortOrder      Int
  allowsMultiDay Boolean  @default(false)
  isActive       Boolean  @default(true)
  coverMediaId   String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events     Event[]
  userAccess UserCategoryAccess[]
}

model UserCategoryAccess {
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  canView    Boolean  @default(true)
  canUpload  Boolean  @default(false)
  canManage  Boolean  @default(false)
  grantedAt  DateTime @default(now())
  grantedBy  String?  @db.Uuid

  @@id([userId, categoryId])
}

// ───────────────────────── Content ─────────────────────────

model Event {
  id           String      @id @default(uuid()) @db.Uuid
  categoryId   String      @db.Uuid
  category     Category    @relation(fields: [categoryId], references: [id])
  title        String      @db.VarChar(160)
  slug         String      @db.VarChar(180)
  eventDate    DateTime    @db.Date
  endDate      DateTime?   @db.Date
  programType  String?     @db.VarChar(60)
  location     String?     @db.VarChar(160)
  description  String?     @db.Text
  status       EventStatus @default(PUBLISHED)
  coverMediaId String?     @db.Uuid
  mediaCount   Int         @default(0)
  photoCount   Int         @default(0)
  videoCount   Int         @default(0)
  totalBytes   BigInt      @default(0)
  createdById  String      @db.Uuid
  createdBy    User        @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedById  String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  deletedById  String?     @db.Uuid

  media      MediaAsset[]
  shareLinks ShareLink[]

  @@unique([categoryId, eventDate, slug])
  @@index([categoryId, eventDate(sort: Desc)])
  @@index([eventDate])
  @@index([deletedAt])
}

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  eventId      String      @db.Uuid
  event        Event       @relation(fields: [eventId], references: [id])
  uploadedById String      @db.Uuid
  uploadedBy   User        @relation("MediaUploadedBy", fields: [uploadedById], references: [id])
  type         MediaType
  status       MediaStatus @default(PENDING_UPLOAD)

  originalFilename String  @db.VarChar(255)
  originalKey      String  @unique
  mimeType         String  @db.VarChar(100)
  detectedMime     String? @db.VarChar(100)
  isRaw            Boolean @default(false)
  sizeBytes        BigInt
  checksumSha256   String? @db.VarChar(64)
  s3UploadId       String?

  width       Int?
  height      Int?
  durationSec Decimal?  @db.Decimal(10, 2)
  takenAt     DateTime?
  cameraModel String?   @db.VarChar(120)

  caption           String? @db.VarChar(1000)
  isFeatured        Boolean @default(false)
  /// Shown on the public highlights gallery. Set only by admins (separate from
  /// isFeatured so featuring inside the app never publishes anything).
  isPublicHighlight Boolean @default(false)
  sortOrder         Int     @default(0)

  processingError    String? @db.VarChar(1000)
  processingAttempts Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  purgeAfter  DateTime?

  variants   MediaVariant[]
  tags       MediaTag[]
  shareItems ShareLinkMedia[]

  @@index([eventId, status, deletedAt])
  @@index([eventId, takenAt])
  @@index([uploadedById])
  @@index([status])
  @@index([purgeAfter])
  @@index([isPublicHighlight])
}

model MediaVariant {
  id        String      @id @default(uuid()) @db.Uuid
  mediaId   String      @db.Uuid
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind      VariantKind
  key       String      @unique
  mimeType  String      @db.VarChar(100)
  width     Int?
  height    Int?
  sizeBytes BigInt
  createdAt DateTime    @default(now())

  @@unique([mediaId, kind])
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.Citext
  createdAt DateTime   @default(now())
  media     MediaTag[]
}

model MediaTag {
  mediaId String     @db.Uuid
  tagId   String     @db.Uuid
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

// ───────────────────────── Sharing & exports (§19) ─────────────────────────

/// A time-limited link for people outside the system. Either a whole event
/// (eventId set, media empty) or a hand-picked selection (media rows).
model ShareLink {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  /// First 8 chars of the token, so admins can tell links apart. Not secret enough to use.
  tokenPrefix   String    @db.VarChar(8)
  title         String    @db.VarChar(160)
  eventId       String?   @db.Uuid
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passwordHash  String?
  allowDownload Boolean   @default(false)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdById   String    @db.Uuid
  createdBy     User      @relation(fields: [createdById], references: [id])
  viewCount     Int       @default(0)
  downloadCount Int       @default(0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())

  media ShareLinkMedia[]

  @@index([eventId])
  @@index([createdById])
  @@index([expiresAt])
}

model ShareLinkMedia {
  shareLinkId String     @db.Uuid
  mediaId     String     @db.Uuid
  shareLink   ShareLink  @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([shareLinkId, mediaId])
  @@index([mediaId])
}

/// ZIP export of an event or a selection, built by the worker into exports/.
model ExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  requestedById String?      @db.Uuid
  requestedBy   User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  shareLinkId   String?      @db.Uuid
  eventId       String?      @db.Uuid
  mediaIds      String[]     @db.Uuid
  title         String       @db.VarChar(160)
  status        ExportStatus @default(PENDING)
  key           String?
  fileCount     Int          @default(0)
  sizeBytes     BigInt       @default(0)
  error         String?      @db.VarChar(1000)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([shareLinkId])
  @@index([expiresAt])
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(30)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @db.Inet
  userAgent  String?  @db.VarChar(400)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
}

/// Extra permissions a Super Admin has granted to a whole role.
model RolePermission {
  role       Role
  permission String   @db.VarChar(60)
  createdAt  DateTime @default(now())

  @@id([role, permission])
}

// ---------------------------------------------------------------- Membership & attendance

enum GroupType {
  CONSTITUENCY
  BASONTA
  BACENTA
}

enum AttendanceKind {
  CHURCH_SERVICE
  GROUP_MEETING
}

enum GuestIntent {
  VISIT
  JOINING
}

/// Constituency (led by a head pastor) → basontas inside it; bacentas are church-wide
/// ministries (media, choir, ushers…). Each is led by a pastor (an app user).
model ChurchGroup {
  id              String        @id @default(uuid()) @db.Uuid
  type            GroupType
  name            String        @db.VarChar(80)
  description     String?       @db.VarChar(500)
  meetingDay      String?       @db.VarChar(40)
  meetingPlace    String?       @db.VarChar(160)
  pastorId        String?       @db.Uuid
  pastor          User?         @relation("GroupPastor", fields: [pastorId], references: [id], onDelete: SetNull)
  createdById     String?       @db.Uuid
  createdBy       User?         @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// A basonta's constituency.
  parentId        String?       @db.Uuid
  parent          ChurchGroup?  @relation("GroupParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        ChurchGroup[] @relation("GroupParent")
  /// A bacenta\'s overall team lead (a member).
  leadMemberId    String?       @db.Uuid
  leadMember      Member?       @relation("GroupLead", fields: [leadMemberId], references: [id], onDelete: SetNull)
  /// Bacentas only: its pastor and shepherds record church-service head-counts (e.g. Ushers).
  recordsServices Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members        Member[]            @relation("MemberConstituency")
  basontaMembers Member[]            @relation("MemberBasonta")
  bacentaMembers MemberBacenta[]
  roles          BacentaRole[]
  sessions       AttendanceSession[]
  shepherds      GroupShepherd[]
  rosterSlots    RosterSlot[]
  churchEvents   ChurchEvent[]
  announcements  AnnouncementGroup[]

  @@unique([type, name])
  @@index([pastorId])
  @@index([parentId])
}

/// A church member (not an app login).
model Member {
  id             String       @id @default(uuid()) @db.Uuid
  fullName       String       @db.VarChar(120)
  phone          String?      @db.VarChar(30)
  email          String?      @db.Citext
  gender         String?      @db.VarChar(10)
  dateOfBirth    DateTime?    @db.Date
  location       String?      @db.VarChar(160)
  churchRole     String       @default("Member") @db.VarChar(60)
  constituencyId String?      @db.Uuid
  constituency   ChurchGroup? @relation("MemberConstituency", fields: [constituencyId], references: [id], onDelete: SetNull)
  /// One basonta, inside their constituency.
  basontaId      String?      @db.Uuid
  basonta        ChurchGroup? @relation("MemberBasonta", fields: [basontaId], references: [id], onDelete: SetNull)
  joinedOn       DateTime?    @db.Date
  isActive       Boolean      @default(true)
  notes          String?      @db.VarChar(1000)
  createdById    String?      @db.Uuid
  createdBy      User?        @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bacentas      MemberBacenta[]
  leadsGroups   ChurchGroup[]      @relation("GroupLead")
  leadsTeams    BacentaRole[]      @relation("TeamLead")
  attendance    AttendanceRecord[]
  guestsBrought Guest[]            @relation("GuestBroughtBy")
  convertedFrom Guest?             @relation("GuestConverted")
  account       User?              @relation("MemberAccount")
  /// Checks in with this person (children, members without a phone).
  guardianId    String?            @db.Uuid
  guardian      Member?            @relation("Household", fields: [guardianId], references: [id], onDelete: SetNull)
  dependants    Member[]           @relation("Household")
  invitations   Invitation[]       @relation("MemberInvite")
  followUps     FollowUp[]
  rosterSlots   RosterSlot[]
  milestones    Milestone[]

  @@index([constituencyId])
  @@index([basontaId])
  @@index([fullName])
}

/// A member serving in a bacenta (any number), with team roles inside it.
model MemberBacenta {
  memberId String              @db.Uuid
  member   Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId  String              @db.Uuid
  group    ChurchGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles    MemberBacentaRole[]

  @@id([memberId, groupId])
  @@index([groupId])
}

/// A team role defined by a bacenta (e.g. Media: mixing, projecting, live streaming).
model BacentaRole {
  id          String              @id @default(uuid()) @db.Uuid
  groupId     String              @db.Uuid
  group       ChurchGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String              @db.VarChar(60)
  /// Team lead for this role (a member of the bacenta).
  leadId      String?             @db.Uuid
  lead        Member?             @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  rosterSlots RosterSlot[]
  members     MemberBacentaRole[]

  @@unique([groupId, name])
}

model MemberBacentaRole {
  memberId   String        @db.Uuid
  groupId    String        @db.Uuid
  membership MemberBacenta @relation(fields: [memberId, groupId], references: [memberId, groupId], onDelete: Cascade)
  roleId     String        @db.Uuid
  role       BacentaRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId, roleId])
  @@index([roleId])
}

/// A church-wide service (groupId null) or a group meeting, on a date. serviceType is
/// free text with suggestions (Sunday service, all-night, camp, conference…).
model AttendanceSession {
  id              String         @id @default(uuid()) @db.Uuid
  kind            AttendanceKind
  serviceType     String         @db.VarChar(40)
  groupId         String?        @db.Uuid
  group           ChurchGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date            DateTime       @db.Date
  title           String?        @db.VarChar(120)
  visitorCount    Int            @default(0)
  firstTimerCount Int            @default(0)
  /// Church services: total head-count (members + visitors + new converts); null for group meetings.
  headcount       Int?
  newConvertCount Int            @default(0)
  notes           String?        @db.VarChar(1000)
  /// Self check-in (church services): the code in the QR, valid until checkinUntil.
  checkinCode     String?        @unique @db.VarChar(40)
  checkinUntil    DateTime?
  recordedById    String?        @db.Uuid
  recordedBy      User?          @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  records AttendanceRecord[]
  guests  Guest[]

  @@index([date])
  @@index([groupId, date])
}

/// A member present at a session (absence = no row).
model AttendanceRecord {
  sessionId    String            @db.Uuid
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId     String            @db.Uuid
  member       Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// People this member brought: null = not recorded, 0 = brought nobody.
  broughtCount Int?
  /// How it was recorded: null = on the sheet, SELF = scanned the QR code, FAMILY = checked in by
  /// their guardian, PHONE = typed their phone number at the QR code.
  via          String?           @db.VarChar(10)
  checkedInAt  DateTime?

  @@id([sessionId, memberId])
  @@index([memberId])
}

/// A shepherd (app user) helping lead a group.
model GroupShepherd {
  groupId   String      @db.Uuid
  group     ChurchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

/// Someone a member brought to a service or meeting.
model Guest {
  id                String             @id @default(uuid()) @db.Uuid
  /// Null for visitor cards filled in by the visitor (QR code).
  sessionId         String?            @db.Uuid
  session           AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Visitor cards: where they stay, how they heard, prayer request.
  location          String?            @db.VarChar(160)
  howHeard          String?            @db.VarChar(160)
  prayerRequest     String?            @db.VarChar(1000)
  followUps         FollowUp[]
  broughtById       String?            @db.Uuid
  broughtBy         Member?            @relation("GuestBroughtBy", fields: [broughtById], references: [id], onDelete: SetNull)
  fullName          String?            @db.VarChar(120)
  phone             String?            @db.VarChar(30)
  intent            GuestIntent        @default(VISIT)
  /// Self check-in: who they are to the member (child, relative, friend).
  relation          String?            @db.VarChar(40)
  convertedMemberId String?            @unique @db.Uuid
  convertedMember   Member?            @relation("GuestConverted", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@index([sessionId])
  @@index([broughtById])
  @@index([intent, convertedMemberId])
}

/// A browser/app push subscription (Web Push) for one device.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------- follow-ups

enum FollowUpStatus {
  OPEN
  CONTACTED
  VISITED
  UNREACHABLE
  DONE
}

/// Someone to follow up (a new person who wants to join, or a member not seen), assigned to a leader.
model FollowUp {
  id           String         @id @default(uuid()) @db.Uuid
  memberId     String?        @db.Uuid
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guestId      String?        @db.Uuid
  guest        Guest?         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reason       String         @db.VarChar(160)
  status       FollowUpStatus @default(OPEN)
  assignedToId String?        @db.Uuid
  assignedTo   User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?        @db.Uuid
  createdBy    User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueOn        DateTime?      @db.Date
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  notes        FollowUpNote[]

  @@index([assignedToId, status])
  @@index([status, dueOn])
}

model FollowUpNote {
  id         String          @id @default(uuid()) @db.Uuid
  followUpId String          @db.Uuid
  followUp   FollowUp        @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  authorId   String?         @db.Uuid
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status     FollowUpStatus?
  text       String          @db.VarChar(1000)
  createdAt  DateTime        @default(now())

  @@index([followUpId])
}

// ---------------------------------------------------------------- bacenta rosters

/// Who serves in which team on a date (e.g. Media → Live streaming → Sun 16 Nov, 1st service).
model RosterSlot {
  id          String       @id @default(uuid()) @db.Uuid
  groupId     String       @db.Uuid
  group       ChurchGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roleId      String?      @db.Uuid
  role        BacentaRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  date        DateTime     @db.Date
  service     String?      @db.VarChar(60)
  memberId    String       @db.Uuid
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  note        String?      @db.VarChar(200)
  createdById String?      @db.Uuid
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([groupId, date])
  @@index([memberId, date])
}

// ---------------------------------------------------------------- events & RSVPs

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

/// A church calendar event (camp, conference, all-night…), church-wide or for one group.
model ChurchEvent {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  location    String?      @db.VarChar(160)
  startsAt    DateTime
  endsAt      DateTime?
  groupId     String?      @db.Uuid
  group       ChurchGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rsvpEnabled Boolean      @default(true)
  capacity    Int?
  createdById String?      @db.Uuid
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rsvps       EventRsvp[]

  @@index([startsAt])
}

model EventRsvp {
  eventId   String      @db.Uuid
  event     ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  /// Extra people coming with them.
  guests    Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@id([eventId, userId])
}

// ---------------------------------------------------------------- milestones

/// Foundation school, baptism, wedding (anniversary), salvation…
model Milestone {
  id          String   @id @default(uuid()) @db.Uuid
  memberId    String   @db.Uuid
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(40)
  date        DateTime @db.Date
  note        String?  @db.VarChar(300)
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([type])
}

// ---------------------------------------------------------------- announcements

enum AnnouncementAudience {
  CHURCH
  GROUPS
  LEADERS
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String               @db.VarChar(120)
  body        String               @db.VarChar(5000)
  linkUrl     String?              @db.VarChar(500)
  audience    AnnouncementAudience @default(CHURCH)
  pinned      Boolean              @default(false)
  publishAt   DateTime             @default(now())
  expiresAt   DateTime?
  /// Set once the push notification has gone out (scheduled ones are sent by the worker).
  notifiedAt  DateTime?
  createdById String?              @db.Uuid
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  groups      AnnouncementGroup[]
  reads       AnnouncementRead[]

  @@index([publishAt])
}

model AnnouncementGroup {
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  groupId        String       @db.Uuid
  group          ChurchGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([announcementId, groupId])
  @@index([groupId])
}

model AnnouncementRead {
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

/// A QR code anyone can scan to ask for an account with this role (never Super Admin).
model JoinLink {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(40)
  label       String       @db.VarChar(80)
  role        Role
  categoryIds String[]     @db.Uuid
  maxUses     Int?
  uses        Int          @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String       @db.Uuid
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  invitations Invitation[]
}
