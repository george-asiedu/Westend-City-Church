{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::wcc-media-prod/media/*", "arn:aws:s3:::wcc-media-prod/exports/*", "arn:aws:s3:::wcc-media-prod/avatars/*"]
    },
    {
      "Sid": "ListForCleanupAndHealth",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::wcc-media-prod"
    }
  ]
}
