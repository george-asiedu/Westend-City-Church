# WCC Media HTTP API. Installed by setup.sh.
#   journalctl -u wcc-api -f
[Unit]
Description=WCC Media API
After=network-online.target redis-server.service postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=wcc
Group=wcc
WorkingDirectory=/srv/wcc-media/current
EnvironmentFile=/etc/wcc/app.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5070
Environment=TRUST_PROXY_HOPS=1
ExecStart=/usr/bin/node --enable-source-maps apps/api/dist/main.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LimitNOFILE=65536
# Shares an 8 GB box with Nichelle and Zuri: keep it small.
MemoryMax=640M

[Install]
WantedBy=multi-user.target
