# Production settings for WCC Media. Lives at /etc/wcc/app.env
# (root:wcc, 640). Edit with `sudoedit /etc/wcc/app.env`, then
#   sudo systemctl restart wcc-api wcc-worker
# Values with `$` must be single-quoted (the deploy script sources this file).
# NODE_ENV/HOST/PORT are set by the systemd units.

APP_NAME="WCC Media — The Life Cathedral"

# ── The web app's public URL (Vercel). Browsers only talk to this origin; it
#    proxies /api/* here. Used for the CSRF Origin check and links in emails.
WEB_ORIGIN=https://YOUR-PROJECT.vercel.app
# Extra allowed origins, comma separated (e.g. a custom domain later).
CORS_ORIGINS=
API_PREFIX=api/v1
# Only for cloudfront mode (must be the shared parent domain, e.g. .media.westendcity.church)
COOKIE_DOMAIN=

# ── Database (pooled URL for the app; direct URL for migrations). Quote them: they contain `&`.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/wcc_media?sslmode=require'
DATABASE_MIGRATION_URL='postgresql://USER:PASSWORD@HOST/wcc_media?sslmode=require'

# ── Redis: Nichelle's Redis, our own database (2) so queues never mix
REDIS_URL="redis://:__REDIS_PASSWORD__@127.0.0.1:6379/2"
QUEUE_PREFIX=wcc

# ── Secrets: `openssl rand -base64 64` / `openssl rand -base64 32`
JWT_ACCESS_SECRET=
APP_ENCRYPTION_KEY=
REQUIRE_2FA_FOR_ADMINS=true
PWNED_PASSWORD_CHECK=true

# ── AWS (IAM user wcc-media-app, policy infra/aws/iam-app-policy.json)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=wcc-media-prod

# ── Delivery. s3-presign works without a domain. With the domain + CloudFront:
#    MEDIA_DELIVERY_MODE=cloudfront and the three CLOUDFRONT_* values.
MEDIA_DELIVERY_MODE=s3-presign
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=/etc/wcc/cf_private_key.pem

# ── Limits & processing (sized for the shared Cloud VPS 4)
MAX_IMAGE_MB=60
MAX_VIDEO_GB=20
IMAGE_CONCURRENCY=2
VIDEO_CONCURRENCY=1
FFMPEG_THREADS=2
WORKER_TMP_RESERVE_GB=15
EXPORT_MAX_GB=10
VIDEO_TRANSCODE_ENABLED=true
TRASH_RETENTION_DAYS=30

# ── Features
SHARE_LINKS_ENABLED=true
PUBLIC_HIGHLIGHTS_ENABLED=false
SWAGGER_ENABLED=false

# ── Mail: Plunk (same provider as Nichelle). From domain must be verified in Plunk.
PLUNK_SECRET=
MAIL_FROM="WCC Media <no-reply@westendcity.church>"
MAIL_REPLY_TO=
# Optional public https URL of the logo shown in emails (default: WEB_ORIGIN/logo.png when https)
MAIL_LOGO_URL=


# Push notifications. Generate once on the server:
#   cd /srv/wcc-media/current/apps/worker && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:customersupport@zuristudios.com
NOTIFY_TZ=Africa/Accra
# Reminders Sat 20:00 / Sun 13:00; numbers Sat 22:00 / Sun 18:00 (cron, NOTIFY_TZ)
REMINDER_CRON_SATURDAY="0 20 * * 6"
REMINDER_CRON_SUNDAY="0 13 * * 0"
STATS_CRON_SATURDAY="0 22 * * 6"
STATS_CRON_SUNDAY="0 18 * * 0"
